# 외부 연동은 현재 MVP 범위에 포함되지 않습니다.
# 향후 환경 변수가 필요해지면 실제 값 없이 키 이름만 추가하세요.

# 선택 사항이며 기본값은 .data/creator-history.sqlite입니다.
HISTORY_DATABASE_PATH=.data/creator-history.sqlite

# YouTube 공급자: 기본값 innertube, 선택값 innertube | official
YOUTUBE_PROVIDER=innertube

# official 선택 시에만 필요한 YouTube Data API v3 키
YOUTUBE_API_KEY=
YOUTUBE_REQUEST_TIMEOUT_MS=
YOUTUBE_MAX_RETRIES=

# H4.2 자동 실행 안전 상한(비워 두면 안전한 기본값 사용)
SCOUTING_MAX_SCANNED_CANDIDATES=
SCOUTING_MAX_DISCOVERY_PAGES=
SCOUTING_MAX_RUN_DURATION_MS=
SCOUTING_MAX_PROVIDER_FAILURES=

# H5.1 공개 리크루팅 수집 제한(비워 두면 안전한 기본값 사용)
RECRUITMENT_CONSUMER_DOMAINS=
RECRUITMENT_REQUEST_TIMEOUT_MS=
RECRUITMENT_MAX_PAGES_PER_SITE=
RECRUITMENT_MAX_OFFICIAL_SITES=
RECRUITMENT_MAX_REDIRECTS=
RECRUITMENT_MAX_RESPONSE_BYTES=
RECRUITMENT_MAX_CONCURRENCY=
RECRUITMENT_MIN_HOST_INTERVAL_MS=
RECRUITMENT_MAX_429_RETRIES=
